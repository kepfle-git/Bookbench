#: settings.py:524
msgid "Google Books"
msgstr "Google Books"

#: settings.py:524
msgid "Free, no key. Usually smaller images."
msgstr "Kostenlos, ohne Schlüssel. Meist kleinere Bilder."

#: settings.py:525
msgid "Which images count"
msgstr "Welche Bilder zählen"

#: settings.py:526
msgid "Smallest height (px):"
msgstr "Kleinste Höhe (px):"

#: settings.py:527
